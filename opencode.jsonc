{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    // Cualquier comando de shell pide aprobación antes de ejecutarse.
    { "action": "shell", "resource": "*", "effect": "ask" },
    // El comando de tests del proyecto se ejecuta sin pedir aprobación.
    { "action": "shell", "resource": "python3 -m unittest *", "effect": "allow" }
  ]
}
